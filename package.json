{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brain": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "web:build": "bun run scripts/build-web.ts",
    "web": "bun run scripts/build-web.ts && bun run src/cli.ts serve",
    "extension:build": "bun run scripts/build-extension.ts",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@opendocsg/pdf2md": "0.3.2",
    "sqlite-vec": "0.1.9",
    "ulid": "^3.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/bun": "latest",
    "@types/chrome": "^0.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0"
  }
}
